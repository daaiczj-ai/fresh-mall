PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fresh_mall
DB_USER=root
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# 微信小程序（真机登录必填 AppSecret）
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# 微信支付（真机真实付款需全部配置，且 NOTIFY_URL 必须是公网 HTTPS）
WX_MCH_ID=your_mch_id
WX_API_KEY=your_api_key
WX_NOTIFY_URL=https://your-domain.com/api/pay/notify

# 上传
UPLOAD_DIR=uploads
BASE_URL=http://localhost:3000
