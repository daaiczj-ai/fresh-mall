.page { padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; }
.title { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 24rpx; }
.rating-row { display: flex; align-items: center; margin-bottom: 24rpx; }
.label { margin-right: 16rpx; color: #666; }
.stars { display: flex; gap: 8rpx; }
.star { font-size: 48rpx; color: #ddd; }
.star.active { color: #FFB800; }
.content { width: 100%; min-height: 200rpx; background: #f5f6fa; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; }
.anonymous { display: flex; justify-content: space-between; align-items: center; margin-top: 24rpx; }
.btn-submit { margin-top: 40rpx; background: #2ECC71; color: #fff; border-radius: 44rpx; border: none; }
.btn-submit::after { border: none; }
