<view class="page">
  <view class="card">
    <text class="title" wx:if="{{productName}}">{{productName}}</text>
    <view class="rating-row">
      <text class="label">评分</text>
      <view class="stars">
        <text
          class="star {{rating >= item ? 'active' : ''}}"
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          bindtap="setRating"
          data-value="{{item}}"
        >★</text>
      </view>
    </view>
    <textarea class="content" placeholder="说说商品怎么样吧~" value="{{content}}" bindinput="onInput" maxlength="200" />
    <view class="anonymous">
      <text>匿名评价</text>
      <switch checked="{{isAnonymous}}" bindchange="toggleAnonymous" color="#2ECC71" />
    </view>
  </view>
  <button class="btn-submit" bindtap="submit">提交评价</button>
</view>
