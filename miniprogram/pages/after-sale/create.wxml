<view class="page">
  <view class="card">
    <text class="label">售后类型</text>
    <view class="type-row">
      <view class="type-item {{type === 'refund' ? 'active' : ''}}" bindtap="selectType" data-type="refund">仅退款</view>
      <view class="type-item {{type === 'return' ? 'active' : ''}}" bindtap="selectType" data-type="return">退货退款</view>
      <view class="type-item {{type === 'exchange' ? 'active' : ''}}" bindtap="selectType" data-type="exchange">换货</view>
    </view>
  </view>

  <view class="card">
    <text class="label">退款金额（元）</text>
    <input class="input" type="digit" placeholder="选填" value="{{refundAmount}}" bindinput="onAmountInput" />
  </view>

  <view class="card">
    <text class="label">原因</text>
    <input class="input" placeholder="请简要说明原因" value="{{reason}}" bindinput="onReasonInput" />
    <textarea class="textarea" placeholder="补充说明（选填）" value="{{description}}" bindinput="onDescInput" />
  </view>

  <button class="btn-submit" bindtap="submit">提交申请</button>
</view>
