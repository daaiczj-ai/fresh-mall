<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <block wx:elif="{{list.length}}">
    <view class="item-card" wx:for="{{list}}" wx:key="id">
      <view class="item-header">
        <text class="type">{{TYPE_MAP[item.type]}}</text>
        <text class="status status-{{item.status}}">{{STATUS_MAP[item.status]}}</text>
      </view>
      <view class="row"><text class="label">订单号</text><text>{{item.order.order_no || item.order_id}}</text></view>
      <view class="row"><text class="label">原因</text><text>{{item.reason}}</text></view>
      <view class="row" wx:if="{{item.refund_amount}}"><text class="label">退款金额</text><text class="price">¥{{item.refund_amount}}</text></view>
      <view class="row" wx:if="{{item.admin_remark}}"><text class="label">商家回复</text><text>{{item.admin_remark}}</text></view>
      <view class="time text-gray text-sm">{{item.created_at_fmt}}</view>
      <navigator class="link" url="/pages/order/detail?id={{item.order_id}}">查看订单 ›</navigator>
    </view>
  </block>

  <view class="empty" wx:else>暂无售后记录</view>
</view>
