.item-card { background: #fff; margin: 16rpx 24rpx; border-radius: 12rpx; padding: 24rpx; }
.item-header { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.type { font-weight: bold; font-size: 30rpx; }
.status { font-size: 24rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.status-pending { color: #E6A23C; background: #FDF6EC; }
.status-approved { color: #2ECC71; background: #E8F8F0; }
.status-rejected { color: #E74C3C; background: #FDEDEC; }
.status-completed { color: #666; background: #f5f5f5; }
.row { display: flex; margin-bottom: 8rpx; font-size: 26rpx; }
.label { color: #999; width: 140rpx; flex-shrink: 0; }
.price { color: #E74C3C; }
.time { margin-top: 12rpx; }
.link { display: block; margin-top: 16rpx; color: #2ECC71; font-size: 26rpx; }
.empty { text-align: center; color: #999; padding: 100rpx; }
