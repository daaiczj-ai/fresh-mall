.tabs { white-space: nowrap; background: #fff; padding: 0 16rpx; }
.tab { display: inline-block; padding: 24rpx 28rpx; font-size: 28rpx; color: #666; }
.tab.active { color: #2ECC71; font-weight: bold; border-bottom: 4rpx solid #2ECC71; }

.order-card { background: #fff; margin: 16rpx 24rpx; border-radius: 12rpx; padding: 20rpx; }
.order-header { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.order-no { font-size: 24rpx; color: #999; }

.order-goods { display: flex; align-items: center; padding: 8rpx 0; }
.goods-img { width: 100rpx; height: 100rpx; border-radius: 8rpx; margin-right: 16rpx; }
.goods-info { flex: 1; }
.goods-name { display: block; font-size: 26rpx; }
.goods-price { color: #E74C3C; font-size: 26rpx; flex-shrink: 0; }

.order-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f5f5f5; font-size: 26rpx; }
.order-actions { display: flex; gap: 12rpx; }
.action-btn { font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 32rpx; border: 2rpx solid #ddd; background: #fff; line-height: 1.5; }
.action-btn.primary { border-color: #2ECC71; color: #2ECC71; }
.action-btn::after { border: none; }

.empty { text-align: center; color: #999; padding: 100rpx; }
