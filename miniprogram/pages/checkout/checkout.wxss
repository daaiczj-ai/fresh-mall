.page { padding-bottom: 120rpx; }

.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #666;
}

.error-text { color: #E74C3C; margin-bottom: 32rpx; text-align: center; }

.btn-retry {
  background: #2ECC71;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border: none;
}
.btn-retry::after { border: none; }

.delivery-tabs { display: flex; margin: 20rpx 24rpx; padding: 8rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx; border-radius: 8rpx; color: #666; }
.tab.active { background: #E8F8F0; color: #2ECC71; font-weight: bold; }

.address-card { margin: 0 24rpx 20rpx; }
.pickup-card { background: #F0FBF4; border: 2rpx solid #D5F5E3; }
.pickup-tip { color: #666; font-size: 24rpx; margin-top: 8rpx; }
.pickup-tip.highlight { color: #2ECC71; margin-top: 16rpx; }
.address-user { font-weight: bold; margin-bottom: 8rpx; }
.address-detail { color: #666; font-size: 26rpx; }

.card { margin: 0 24rpx 20rpx; }
.card-title { font-weight: bold; display: block; margin-bottom: 16rpx; }

.time-slots { white-space: nowrap; }
.time-slot {
  display: inline-block; padding: 12rpx 24rpx; margin-right: 12rpx;
  border: 2rpx solid #eee; border-radius: 8rpx; font-size: 24rpx;
}
.time-slot.active { border-color: #2ECC71; color: #2ECC71; background: #E8F8F0; }

.goods-item { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.goods-img { width: 100rpx; height: 100rpx; border-radius: 8rpx; margin-right: 16rpx; }
.goods-info { flex: 1; }

.coupon-row { display: flex; justify-content: space-between; align-items: center; }
.coupon-text.active { color: #2ECC71; }

.fee-row { display: flex; justify-content: space-between; padding: 8rpx 0; color: #666; }
.fee-row .discount { color: #2ECC71; }
.fee-row.total { font-weight: bold; color: #333; padding-top: 16rpx; border-top: 1rpx solid #f5f5f5; }

.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; justify-content: flex-end;
  background: #fff; padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.pay-total { margin-right: 24rpx; }
.btn-submit {
  background: linear-gradient(135deg, #2ECC71, #27AE60);
  color: #fff; border-radius: 44rpx; font-size: 28rpx; padding: 16rpx 48rpx; border: none;
}
.btn-submit::after { border: none; }
