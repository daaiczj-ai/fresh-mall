.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F6FA;
}

.category-layout {
  display: flex;
  flex: 1;
  min-height: 0;
}

.category-sidebar {
  width: 180rpx;
  height: 100%;
  background: #F5F6FA;
}

.sidebar-item {
  padding: 28rpx 16rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  border-left: 6rpx solid transparent;
}

.sidebar-item.active {
  background: #fff;
  color: #2ECC71;
  font-weight: bold;
  border-left-color: #2ECC71;
}

.product-list {
  flex: 1;
  height: 100%;
  padding: 16rpx;
}

.product-item {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.item-img { width: 160rpx; height: 160rpx; border-radius: 8rpx; flex-shrink: 0; }
.item-info { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; justify-content: space-between; }
.item-name { font-size: 28rpx; font-weight: 500; }
.item-subtitle { margin-top: 4rpx; }
.item-bottom { display: flex; justify-content: space-between; align-items: center; }
.loading-tip, .empty-tip { text-align: center; padding: 40rpx; color: #999; font-size: 24rpx; }
