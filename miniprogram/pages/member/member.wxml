<view class="page" wx:if="{{memberInfo}}">
  <view class="member-card">
    <text class="level-name">{{memberInfo.currentLevel.name}}</text>
    <text class="points">积分：{{memberInfo.points}}</text>
    <text class="spent">累计消费：¥{{memberInfo.totalSpent}}</text>
  </view>
  <view class="levels card">
    <text class="title">会员等级</text>
    <view class="level-item" wx:for="{{memberInfo.levels}}" wx:key="id">
      <text class="level-label">{{item.name}}</text>
      <text class="text-gray text-sm">消费满¥{{item.min_spent}} · {{item.discountText}}</text>
    </view>
  </view>
</view>
