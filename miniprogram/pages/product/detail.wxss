.page { padding-bottom: 120rpx; }
.image-swiper { height: 750rpx; }
.main-image { width: 100%; height: 750rpx; }

.info-card { margin: 20rpx 24rpx; }
.price-row { display: flex; align-items: baseline; margin-bottom: 12rpx; }
.price { color: #E74C3C; font-size: 48rpx; font-weight: bold; }
.original-price { text-decoration: line-through; margin-left: 12rpx; font-size: 24rpx; }
.unit-price-tip { margin-left: 8rpx; }
.product-name { font-size: 32rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.product-subtitle { display: block; margin-bottom: 8rpx; }

.spec-card { margin: 0 24rpx 20rpx; display: flex; justify-content: space-between; }
.desc-card { margin: 0 24rpx; }
.desc-title { font-weight: bold; display: block; margin-bottom: 12rpx; }
.desc-content { color: #666; line-height: 1.6; }

.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center;
  background: #fff; padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.bar-icon { display: flex; flex-direction: column; align-items: center; margin-right: 24rpx; font-size: 36rpx; }
.icon-text { font-size: 20rpx; color: #666; }

.btn-cart, .btn-buy {
  flex: 1; border-radius: 44rpx; font-size: 28rpx; padding: 16rpx 0; border: none;
}
.btn-cart { background: #FFF3E0; color: #FF9800; margin-right: 12rpx; }
.btn-buy { background: linear-gradient(135deg, #2ECC71, #27AE60); color: #fff; }
.btn-cart::after, .btn-buy::after { border: none; }

.sku-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 200;
  display: flex; align-items: flex-end;
}

.sku-panel {
  width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.sku-header { display: flex; margin-bottom: 32rpx; }
.sku-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; margin-right: 20rpx; }
.sku-selected { display: block; color: #999; font-size: 24rpx; margin-top: 8rpx; }

.sku-section { margin-bottom: 24rpx; }
.sku-label { font-weight: bold; display: block; margin-bottom: 16rpx; }
.sku-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sku-option {
  padding: 12rpx 32rpx; border: 2rpx solid #eee; border-radius: 8rpx; font-size: 26rpx;
}
.sku-option.active { border-color: #2ECC71; color: #2ECC71; background: #E8F8F0; }

.qty-control { display: flex; align-items: center; }
.qty-btn { width: 56rpx; height: 56rpx; border: 2rpx solid #eee; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; }
.qty-num { margin: 0 24rpx; font-size: 28rpx; min-width: 80rpx; text-align: center; }

.btn-confirm {
  width: 100%; background: linear-gradient(135deg, #2ECC71, #27AE60);
  color: #fff; border-radius: 44rpx; margin-top: 16rpx; border: none;
}
.btn-confirm::after { border: none; }
