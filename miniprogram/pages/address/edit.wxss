.form-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.form-item text { width: 160rpx; flex-shrink: 0; }
.form-item input { flex: 1; }
.btn-save { margin: 40rpx 24rpx; background: #2ECC71; color: #fff; border-radius: 44rpx; border: none; }
.btn-save::after { border: none; }
