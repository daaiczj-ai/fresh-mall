<view class="page">
  <view class="form-card card">
    <view class="form-item"><text>联系人</text><input placeholder="姓名" value="{{form.name}}" data-field="name" bindinput="onInput" /></view>
    <view class="form-item"><text>手机号</text><input placeholder="手机号" type="number" value="{{form.phone}}" data-field="phone" bindinput="onInput" /></view>
    <view class="form-item"><text>详细地址</text><input placeholder="街道门牌号" value="{{form.detail}}" data-field="detail" bindinput="onInput" /></view>
    <view class="form-item"><text>设为默认</text><switch checked="{{form.isDefault}}" bindchange="toggleDefault" /></view>
  </view>
  <button class="btn-save" bindtap="save">保存</button>
</view>
