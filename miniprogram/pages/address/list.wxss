.address-card { background: #fff; margin: 16rpx 24rpx; border-radius: 12rpx; padding: 24rpx; }
.addr-header { display: flex; align-items: center; margin-bottom: 8rpx; }
.addr-name { font-weight: bold; }
.default-tag { background: #E8F8F0; color: #2ECC71; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 4rpx; margin-left: 12rpx; }
.addr-detail { color: #666; font-size: 26rpx; }
.addr-actions { display: flex; gap: 32rpx; margin-top: 16rpx; color: #999; font-size: 24rpx; }
.btn-add { margin: 32rpx 24rpx; background: #2ECC71; color: #fff; border-radius: 44rpx; border: none; }
.btn-add::after { border: none; }
