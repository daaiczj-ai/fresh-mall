<page-meta background-color-top="#2ECC71" background-text-style="light" />

<view class="page">

  <custom-nav title="我的" />

  <view class="user-header">

    <view class="user-info" bindtap="login" hover-class="none">

      <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" />

      <view>

        <text class="nickname">{{userInfo.nickname || '点击登录'}}</text>

        <text class="member-tag" wx:if="{{userInfo}}">积分 {{userInfo.points}}</text>

      </view>

    </view>

  </view>



  <view class="order-section card">

    <view class="section-header" bindtap="goOrders">

      <text class="section-title">我的订单</text>

      <text class="text-gray text-sm">全部订单 ›</text>

    </view>

    <view class="order-icons">

      <view class="icon-item" bindtap="goOrders" data-status="pending_payment">

        <text class="icon">💰</text><text>待付款</text>

      </view>

      <view class="icon-item" bindtap="goOrders" data-status="processing">

        <text class="icon">📦</text><text>待处理</text>

      </view>

      <view class="icon-item" bindtap="goOrders" data-status="receiving">

        <text class="icon">🚚</text><text>待收货</text>

      </view>

      <view class="icon-item" bindtap="goOrders" data-status="completed">

        <text class="icon">✅</text><text>已完成</text>

      </view>

    </view>

  </view>



  <view class="menu-section card">

    <view class="menu-item" bindtap="navigate" data-url="/pages/coupon/list?tab=center">
      <text>🎫 领券中心</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="navigate" data-url="/pages/coupon/list">
      <text>🎟️ 我的优惠券</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="navigate" data-url="/pages/after-sale/list">
      <text>🛠️ 我的售后</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="navigate" data-url="/pages/address/list">

      <text>📍 收货地址</text><text class="arrow">›</text>

    </view>

    <view class="menu-item" bindtap="navigate" data-url="/pages/favorite/favorite">

      <text>❤️ 我的收藏</text><text class="arrow">›</text>

    </view>

    <view class="menu-item" bindtap="navigate" data-url="/pages/member/member">

      <text>👑 会员中心</text><text class="arrow">›</text>

    </view>

  </view>

</view>

