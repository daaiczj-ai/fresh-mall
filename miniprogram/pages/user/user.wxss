.user-header {
  background: #2ECC71;
  padding: 24rpx 32rpx 48rpx;
}

.user-info { display: flex; align-items: center; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.5); margin-right: 24rpx; }
.nickname { color: #fff; font-size: 36rpx; font-weight: normal; display: block; }
.member-tag { color: rgba(255,255,255,0.8); font-size: 24rpx; margin-top: 8rpx; display: block; }

.order-section { margin: -24rpx 24rpx 20rpx; position: relative; z-index: 1; }
.section-header { display: flex; justify-content: space-between; margin-bottom: 24rpx; }
.section-title { font-weight: bold; }

.order-icons { display: flex; justify-content: space-around; }
.icon-item { display: flex; flex-direction: column; align-items: center; font-size: 24rpx; color: #666; }
.icon { font-size: 48rpx; margin-bottom: 8rpx; }

.menu-section { margin: 0 24rpx; }
.menu-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 28rpx;
}
.menu-item:last-child { border-bottom: none; }
.arrow { color: #ccc; font-size: 32rpx; }
