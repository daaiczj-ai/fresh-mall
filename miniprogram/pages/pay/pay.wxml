<view class="page" wx:if="{{order}}">
  <view class="amount-section">
    <text class="amount-label">支付金额</text>
    <view class="amount-value">
      <text class="symbol">¥</text>
      <text class="num">{{order.pay_amount}}</text>
    </view>
    <text class="order-no">订单号：{{order.order_no}}</text>
  </view>

  <view class="pay-method card">
    <text class="method-title">支付方式</text>
    <view class="method-item active">
      <text class="method-icon">💚</text>
      <text class="method-name">微信支付</text>
      <text class="method-check">✓</text>
    </view>
    <view class="dev-tip" wx:if="{{isDev}}">当前为开发模式，点击支付将模拟付款</view>
  </view>

  <view class="goods-card card">
    <text class="card-title">商品信息</text>
    <view class="goods-item" wx:for="{{order.items}}" wx:key="id">
      <image class="goods-img" src="{{item.product_image}}" mode="aspectFill" />
      <view class="goods-info">
        <text class="goods-name">{{item.product_name}}</text>
        <text class="goods-qty">x{{item.quantity}}</text>
      </view>
      <text class="goods-price">¥{{item.subtotal}}</text>
    </view>
  </view>

  <view class="bottom-bar safe-bottom">
    <button class="btn-pay" loading="{{paying}}" bindtap="handlePay">
      立即支付 ¥{{order.pay_amount}}
    </button>
  </view>
</view>

<view class="page loading" wx:else>
  <text>加载订单...</text>
</view>
